{
  "name": "Ritual",
  "short_name": "Ritual",
  "description": "A private, local-first habit tracker for small habits kept daily.",
  "start_url": "./",
  "scope": "./",
  "id": "ritual",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#090D0B",
  "theme_color": "#090D0B",
  "categories": ["health", "productivity", "lifestyle"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {"src": "brand/ritual-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"},
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ]
}
